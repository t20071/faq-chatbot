# Copy to .env and fill in. .env is gitignored.

# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides
# SEARCH_MODE=hybrid                   # hybrid (keyword + vector), bm25 or vector
# REWRITE_QUERIES=false                # true: extra LLM call to rewrite follow-ups (+~1 s)
# CHAT_MODEL=openai/gpt-oss-20b        # model that writes the answers
# REWRITE_MODEL=openai/gpt-oss-20b     # model used when REWRITE_QUERIES=true
# JUDGE_MODEL=openai/gpt-oss-120b      # evaluation: LLM judge
